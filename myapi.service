[Unit]
Description=My API Service
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/demo-market-api-aws-tutorial
ExecStart=/home/ec2-user/demo-market-api-aws-tutorial/.venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target